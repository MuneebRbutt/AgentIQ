# Copy to .env (same folder) and adjust. Never commit .env.
# Read by docker compose (POSTGRES_*, REDIS_PORT), the backend and the frontend (VITE_*).

# --- Docker services ---------------------------------------------------------
POSTGRES_USER=agentiq
POSTGRES_PASSWORD=agentiq_dev_password
POSTGRES_DB=agentiq
POSTGRES_PORT=55432
REDIS_PORT=56379

# --- Backend -----------------------------------------------------------------
# development | test | production (production hides /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (readable, for local dev) | json (for servers and log tools)
LOG_FORMAT=console

# Async driver. Older postgresql+psycopg:// values are converted automatically.
DATABASE_URL=postgresql+asyncpg://agentiq:agentiq_dev_password@localhost:55432/agentiq
REDIS_URL=redis://localhost:56379/0

# Allowed browser origins for the API, comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# Seconds each dependency gets to answer the /api/v1/health check.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- Operator login ------------------------------------------------------------
# Signs login tokens. Optional in development (a built-in dev value is used); required in
# production: a random value of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# How long a login lasts, in minutes.
ACCESS_TOKEN_TTL_MINUTES=60
# Wrong passwords in a row before an account is locked, and for how many minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Knowledge base ------------------------------------------------------------
# Folder for the ChromaDB index (inside backend/ unless absolute). Empty = in memory only.
CHROMA_PATH=data/chroma
# minilm (real; downloads an ~80 MB model on first use) | hashing (offline test stand-in)
EMBEDDING_PROVIDER=minilm
# Passages retrieved per question, and the similarity (0-1) a passage needs to count.
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MIN_SCORE=0.30
# Largest document an operator can upload, in bytes (5 MB).
MAX_DOCUMENT_BYTES=5242880

# --- Language model --------------------------------------------------------------
# Any OpenAI-compatible chat API. Leave the key empty to run without a model (knowledge
# answers then quote the documents; bookings need a model). Examples:
#   xAI Grok (keys start with xai-):  LLM_BASE_URL=https://api.x.ai/v1
#   Groq     (keys start with gsk_):  LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama on this computer:          LLM_BASE_URL=http://localhost:11434/v1
# Set LLM_MODEL to a model name from your provider's console, then run:
#   python -m app.cli check-llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Orchestrator --------------------------------------------------------------------
# Below this confidence (0-1) in its reading of a message, the assistant asks instead.
ORCHESTRATOR_MIN_CONFIDENCE=0.5
# Earlier messages the model sees for context.
CONVERSATION_HISTORY_TURNS=10

# --- Sentiment & complaints ---------------------------------------------------------
# model: a sentiment model from Hugging Face, downloaded once (~135 MB) into
# SENTIMENT_MODEL_PATH; if it can't load, the word list is used. lexicon: word list only.
# Check it with:  python -m app.cli check-sentiment "I'm furious about my booking"
SENTIMENT_PROVIDER=model
SENTIMENT_MODEL=Xenova/distilbert-base-multilingual-cased-sentiments-student
SENTIMENT_MODEL_FILE=onnx/model_quantized.onnx
SENTIMENT_MODEL_BASE_URL=https://huggingface.co
SENTIMENT_MODEL_PATH=data/models
# Below this confidence (0-1) an upset reading doesn't escalate; the conversation is
# flagged for review instead.
SENTIMENT_MIN_CONFIDENCE=0.55

# --- Follow-ups and notifications (FR-07; ADR-0007) ------------------------------
# The API sends confirmations, reminders and feedback requests in the background. Set
# this to false if you run `python -m app.cli run-followups` as its own process instead.
FOLLOWUP_WORKER_ENABLED=true
FOLLOWUP_POLL_SECONDS=30
# A message that fails is tried once more after this many minutes, then marked failed.
FOLLOWUP_RETRY_MINUTES=5
# A conversation with no message for this long counts as ended (feedback is asked then).
# 0 = only when it is closed.
CONVERSATION_IDLE_MINUTES=30
# SMS through Twilio: all three are needed, otherwise SMS is only written to the log.
# Find them in the Twilio console. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Added to local numbers such as 0300 1234567 before sending.
SMS_DEFAULT_COUNTRY_CODE=+92
# Email over SMTP (e.g. Gmail with an app password, Brevo, Mailgun). Without SMTP_HOST,
# email is only written to the log. Test with:
#   python -m app.cli check-notifications --email you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Phone calls (FR-02; ADR-0010) --------------------------------------------
# Calls and text messages use the TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN above. Connect a
# number on the dashboard's "Calls, SMS & email" tab (or `python -m app.cli connect-number`),
# then paste the webhook URLs it shows into the number's settings in the Twilio console.
# The public address of this API, e.g. your ngrok URL in development
# (https://abcd-1234.ngrok-free.app) or the deployed URL. Needed for Twilio to reach the
# webhooks and to check their signatures.
PUBLIC_BASE_URL=
# Reject webhooks that aren't signed by Twilio. Only turn off to try them by hand.
TWILIO_VALIDATE_SIGNATURE=true
# Speech to text: twilio (Twilio's recogniser, no extra key, fastest) | whisper (any
# OpenAI-compatible /audio/transcriptions API, e.g. OpenAI whisper-1 or Groq
# https://api.groq.com/openai/v1 with whisper-large-v3).
STT_PROVIDER=twilio
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Text to speech: twilio (<Say>, no extra key) | openai (any OpenAI-compatible
# /audio/speech API; tts-1 is the low-latency model). Test with: python -m app.cli check-voice
TTS_PROVIDER=twilio
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=15
# Language Twilio listens for and the voice it speaks with. For South Asian English
# try VOICE_LANGUAGE=en-IN and VOICE_SAY_VOICE=Polly.Aditi.
VOICE_LANGUAGE=en-US
VOICE_SAY_VOICE=Polly.Joanna
# Times the caller is asked again after saying nothing, before the call ends.
VOICE_MAX_SILENCES=2

# --- Text messages and email from customers (FR-02-02/03; ADR-0011) -------------
# Text messages need nothing more than the Twilio settings above. Messages one sender may
# send one business per hour; more get no answer (stops runaway costs).
INBOUND_MAX_MESSAGES_PER_HOUR=20
# The mailbox customers email, read over IMAP. With Gmail: turn on 2-step verification,
# create an app password, and use imap.gmail.com with that password (and smtp.gmail.com
# for SMTP_* above, which sends the replies). Each business gets a plus address of this
# mailbox (name+clinic@gmail.com), added on the dashboard. Empty = no email channel.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=30

# --- Deployment (FR-10-08; ADR-0012, docs/deployment.md) ------------------------
# The built dashboard (frontend/dist). When set, the API serves it too. The Docker image
# sets this; leave it empty in development, where Vite serves the dashboard.
FRONTEND_DIST=
# Creates the demo business (an operator and the three example profiles) when the
# container starts, once. Used on Render; locally, `python -m app.cli setup-demo` asks for
# the password instead.
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
DEMO_BUSINESS_NAME=AgentIQ Demo

# --- Frontend ----------------------------------------------------------------
VITE_API_URL=http://localhost:8000
